{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmalLoL",
  "version": "0.1.8",
  "identifier": "io.github.zaious.smallol",
  "build": {
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SmalLoL",
        "width": 380,
        "height": 48,
        "minWidth": 180,
        "minHeight": 28,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://smallol-api.chroniclecore.com https://smallol.161.97.96.65.sslip.io https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Sports",
    "shortDescription": "League of Legends pro games, small.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCNTE3MzU1NDQ4QjRCNDEKUldSQlM0dEVWWE5SKzg3VER4ckJuakVKVnFoMHdtSnVFOXlYQ2xBdlhCTlNkVGpuSGQ2MmlBdFcK",
      "endpoints": [
        "https://github.com/Zaious/smallol/releases/latest/download/latest.json"
      ]
    }
  }
}
